{
  "name": "pos-nativo-beta",
  "private": true,
  "version": "1.0.0-beta",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "vitest run --reporter verbose",
    "test:unit": "vitest run src/services src/store --reporter verbose",
    "test:integration": "vitest run src/tests/integration --reporter verbose",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:windows": "tauri build --bundles msi,nsis",
    "package:validate": "node scripts/validate-package.js",
    "package:windows": "npm run typecheck && npm run test:all && npm run tauri:build:windows && npm run package:validate"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
